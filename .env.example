# Copy to .env and fill in your values

# Web panel admin credentials
ADMIN_USER=admin
ADMIN_PASS=your_strong_password_here

# Long random secret for Flask sessions (generate: openssl rand -hex 32)
SECRET_KEY=replace_with_openssl_rand_hex_32_output

# Your server's public IP or domain, used when generating tt:// connection links
SERVER_ADDRESS=1.2.3.4

# Path on the HOST where TrustTunnel binaries and config files live
TRUSTTUNNEL_DIR=/opt/trusttunnel
